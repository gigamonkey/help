# Every environment variable the app knows about. Two uses:
#
#   - Local dev: copy to .env (read via node --env-file-if-exists=.env).
#     With DEV_MODE=true nothing else is required.
#
#   - Production: mirror the secret values into the untracked fly.env and
#     push with make secrets (fly secrets import). PORT and DB_DIR/DB_FILE
#     come from the Dockerfile/fly.toml, not fly.env.

# --- App ---------------------------------------------------------------

# Dev-only: skip real OAuth, enable /dev/login, require no secrets.
# NEVER set this in fly.env.
DEV_MODE=true

PORT=3000

# Where the SQLite database lives (the fly volume is mounted at /data in
# production; defaults are . and help.db).
#DB_DIR=.
#DB_FILE=help.db

# Cookie signing key. Generate one with: node make-secret.ts
SESSION_SECRET=

# Google OAuth (console.cloud.google.com; the redirect URL is <origin>/auth).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/auth

# --- Litestream (production only) --------------------------------------
# S3/Tigris credentials for litestream.yml. If LITESTREAM_BUCKET_NAME is
# unset, run.sh starts the server without replication (and says so loudly).

LITESTREAM_BUCKET_NAME=
LITESTREAM_PATH=
LITESTREAM_ENDPOINT_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
