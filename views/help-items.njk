{% extends 'layout.njk' %}

{% block scripts %}
<script src="/js/update-times.js" type="module"></script>
<script src="/js/live.js" type="module"></script>
{% endblock %}

{% block content %}

  {# live.js swaps this element whenever the queue changes, so it has to
     exist in both the empty and non-empty states. #}
  <div id="queue">

  {% if queue.length > 0 %}
    <div id="items" class="cards">

    {% for item in queue %}
    {% include 'help-card.njk' %}
    {% endfor %}

    </div>

    {% else %}
    <h2>
    {% block emptyQueue %}
    {% endblock %}
    </h2>
  {% endif %}

  </div>

{% endblock %}
