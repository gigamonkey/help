<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width,initial-scale=1" name="viewport" />
    <title>Classroom Help</title>
    <link href="/css/style.css" media="all" rel="stylesheet" type="text/css" />
  </head>
  <body class="welcome">
    <h1>Welcome to BHS CS Classroom Help!</h1>

    {% if isAdmin %}
      <p>Here are the classes you’ve already set up.</p>
    {% else %}
      <p>Here are the classes you are already a member of.</p>
    {% endif %}

    <div class="classes">
      {% for m in memberships %}
        <h2><a href="/c/{{m.class_id}}/help">{{m.name}}</a></h2>
      {% endfor %}
    </div>

    {% if isAdmin %}
      <div class="teachers">
        <h2>For teachers</h2>
        <p class='fine-print'>
          These are your classes in Google Classroom. Click Create to import the
          class from Classroom and create a help queue or Resync to synchronize
          our database with Classroom. Resync will add missing students and remove
          students no longer in your class but will not touch current students.
        </p>
        <table>
          <tbody>
            {% for course in courses %}
              <tr>
                <td>
                  {% if googleIds.indexOf(course.id) > -1 %}
                    <a href="/c/{{course.id}}/students">{{ course.fullName }}</a>
                  {% else %}
                    {{ course.fullName }}
                  {% endif %}
                </td>
                <td>
                  {% if googleIds.indexOf(course.id) > -1 %}
                    <a class="button" href="/classes/{{course.id}}/resync">Resync</a>
                  {% else %}
                    <a class="button" href="/classes/{{course.id}}/create">Create</a>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        <p>
          <a class="button" href="/classes/create-all">Create all</a>
          <a class="button" href="/classes/resync-all">Sync all</a>
        </p>
      </div>

      {% if isOwner %}
        <div class="admin">
          <h2>For admin</h2>
          <p class='fine-print'>
            All the classes that have been set up, whoever the teacher.
          </p>
          <table>
            <thead>
              <tr>
                <th>Class</th>
                <th>Teacher</th>
                <th>Posts</th>
              </tr>
            </thead>
            <tbody>
              {% for c in allClasses %}
                <tr>
                  <td><a href="/c/{{c.id}}/help">{{c.name}}</a></td>
                  <td>{{c.teachers}}</td>
                  <td>{{c.posts}}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    {% else %}
      <p>
        Don’t see your class here? Ask your teacher if the class has been set up.
        They may need to resync with Classroom if you’ve joined since they set up
        their help queue.
      </p>
    {% endif %}
  </body>
</html>
