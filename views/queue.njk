<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width,initial-scale=1" name="viewport">
  <title>{{ title }}</title>
  <link href="/css/style.css" media="all" rel="stylesheet" type="text/css">
  <script src="/js/update-times.js" type="module"></script>
  <script src="/js/live.js" type="module"></script>
</head>
<body class="queue" data-events="/c/{{class_id}}/events">

  <a class="homeicon" href="/">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-house-fill" viewBox="0 0 16 16">
      <path d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L8 2.207l6.646 6.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.707 1.5Z"/>
      <path d="m8 3.293 6 6V13.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 13.5V9.293l6-6Z"/>
    </svg>
  </a>

  <div class="container">

  {% if className %}
  <h1 class="classname"><a href="./help">{{ className }}</a></h1>
  {% endif %}

  {# live.js swaps this element whenever the queue changes and at the
     next bell (data-refresh-in, seconds), so it has to exist in both the
     empty and non-empty states and it wraps the period countdown, which
     comes and goes with the class's period. #}
  <div id="queue" data-refresh-in="{{ refresh_in }}">

  {% if period_left %}
  <div class="countdown" data-seconds-left="{{ period_left }}"></div>
  {% endif %}

  {% if queue.length > 0 %}
    <div id="items" class="cards">

    {% for item in queue %}
    {% include 'help-card.njk' %}
    {% endfor %}

    </div>

    {% else %}
    <h2>
      🎉 Nobody waiting! 🎉
    </h2>
  {% endif %}

  </div>

  </div>
</body>
</html>
