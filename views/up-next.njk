{% extends 'help-items.njk' %}

{% set title = "Up next" %}

{% block scripts %}
{{ super() }}
<script src="/js/help-form.js" type="module"></script>
{% endblock %}

{% block beforeTitle %}
<form method="POST">
  <label for="problem">
    What do you need help with?
  </label>

  <textarea id="problem" name="problem" class="required" data-maxlength="{{ HELP_MAX_CHARS }}">{{ problem }}</textarea>

  <div class="form-row">
    <button id="submit">Submit</button>
    <span id="char-count" class="char-count"></span>
  </div>

  {% include 'too-long.njk' %}
</form>
{% endblock %}

{% block emptyQueue %}
🎉 Nobody waiting! 🎉
{% endblock %}
